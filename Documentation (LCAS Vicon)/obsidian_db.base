filters:
  and:
    - file.hasTag("Documentation")
views:
  - type: table
    name: Obsidian-only Page DB Display
    groupBy:
      property: Section
      direction: ASC
    order:
      - file.name
      - file.ctime
      - file.mtime
      - Chapter Number
      - Page Number
      - Chapter
    sort:
      - property: file.name
        direction: ASC
      - property: Chapter
        direction: ASC
